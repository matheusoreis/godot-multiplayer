[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
windows.debug.x86_64 = "res://addons/framed/windows/framed.dll"
windows.release.x86_64 = "res://addons/framed/windows/framed.dll"
linux.debug.x86_64 = "res://addons/framed/linux/framed.so"
linux.release.x86_64 = "res://addons/framed/linux/framed.so"
macos.debug.arm64 = "res://addons/framed/macos/framed.dylib"
macos.release.arm64 = "res://addons/framed/macos/framed.dylib"
